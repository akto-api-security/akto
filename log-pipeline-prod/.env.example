# Private IP of this VM (filled in by setup-vm.sh). Mongo/Kafka are published ONLY on this address.
PRIVATE_IP=__PRIVATE_IP__

# --- Mongo (logs). Password is generated by setup-vm.sh. Apps use:
#   mongodb://logs_admin:<password>@<PRIVATE_IP>:27017/?authSource=admin
MONGO_IMAGE=mongo:8.0.34   # pinned (tested version); upgrade deliberately, never via a floating tag
MONGO_USER=logs_admin
MONGO_PASSWORD=__MONGO_PASSWORD__
MONGO_MEM_LIMIT=10g
MONGO_CACHE_GB=4

# --- Kafka. Default = Kafka runs on this VM (docker compose --profile kafka up -d).
# To use an EXISTING Kafka instead, set the real broker list here and do NOT use --profile kafka.
KAFKA_BOOTSTRAP=kafka:19092
KAFKA_MEM_LIMIT=5g
KAFKA_HEAP=-Xms2g -Xmx2g

# --- Consumer (2 replicas x LOG_CONSUMER_THREADS = 10 = partitions)
CONSUMER_IMAGE=log-consumer:local
CONSUMER_REPLICAS=2
LOG_CONSUMER_THREADS=5
CONSUMER_MEM_LIMIT=1536m
CONSUMER_JAVA_OPTS=-Xmx1g
