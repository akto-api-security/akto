# Copy to config.env and fill in values:
#   cp apps/dashboard/scripts/config.env.example apps/dashboard/scripts/config.env

# --- Core ---
AKTO_MONGO_CONN=mongodb://localhost:27017/admini
DASHBOARD_MODE=local_deploy
JETTY_PORT=8081
AKTO_LOG_LEVEL=INFO
SKIP_SSRF_CHECK=true

# --- Azure OpenAI ---
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_HOST=https://akto-ai-agents.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-04-01-preview

# --- Local services ---
THREAT_DETECTION_BACKEND_URL=http://localhost:9090
PUPPETEER_REPLAY_SERVICE_URL=http://localhost:3000

# --- Installer Version Control (S3 list/deploy) ---
# Long-lived keys: ACCESS_KEY + SECRET only.
# Temporary / STS (ASIA… keys): also set AWS_SESSION_TOKEN (required).
# Lowercase aws_access_key_id / aws_secret_access_key / aws_session_token also work.
AKTO_ENDPOINT_AGENTS_BUCKET=akto-endpoint-agents
AKTO_ENDPOINT_AGENTS_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Local only: S3 feed account (nginx-demo). Unset in production → uses login account.
# With this set, dashboard also reads legacy layout atlas-installers/<type>/<accountId>/
# (nginx-demo Windows standalone feeds). Override with AKTO_ENDPOINT_SHIELD_LEGACY_S3_LAYOUT=false
# once feeds live under atlas-installers/<accountId>/<type>/.
AKTO_ENDPOINT_SHIELD_ACCOUNT_ID=1726615470
