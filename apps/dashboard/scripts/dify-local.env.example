# Copy to dify-local.env and fill in values as needed.
# Used by start-dify-local-stack.sh and start-data-ingestion-local.sh

AKTO_MONGO_CONN=mongodb://localhost:27017/admini

# Local cyborg (database-abstractor) — use localhost:8082 when running cyborg locally
DATABASE_ABSTRACTOR_SERVICE_URL=http://localhost:8082
# JWT from Connectors → Dify (required when cyborg enforces auth)
DATABASE_ABSTRACTOR_SERVICE_TOKEN=

# data-ingestion-service port (team standard: 8090)
DATA_INGESTION_PORT=8090
GUARDRAILS_PORT=9091

# Kafka (required for standard data-ingestion startup — not USE_HTTP_INGEST)
AKTO_KAFKA_BROKER_URL=localhost:29092
AKTO_KAFKA_TOPIC=akto.api.logs
AKTO_KAFKA_PRODUCER_BATCH_SIZE=10
AKTO_KAFKA_PRODUCER_LINGER_MS=10
AKTO_TRAFFIC_BATCH_SIZE=100
AKTO_TRAFFIC_BATCH_TIME_SECS=10

ENABLE_GUARDRAILS=true
RUNTIME_MODE=HYBRID
GUARDRAILS_SERVICE_URL=http://localhost:9091
LOG_LEVEL=DEBUG
AKTO_DI_AUTHENTICATE=false

# Optional: comma-separated revoked JWTs (AuthFilter blocks these even when auth is off)
# AKTO_DI_REVOKED_TOKENS=

# Optional: ngrok for cloud Dify
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Optional: start Kafka via docker compose for inventory
START_KAFKA=false
