<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">
<!-- Jetty 12 EE8 (javax.servlet) context config. Must use the ee8 WebAppContext class.
     Response gzip is handled by the server-level `gzip` module (see Dockerfile), so the old
     <Set name="handler">GzipHandler</Set> injection (a Jetty 9 idiom) is intentionally removed. -->
<Configure class="org.eclipse.jetty.ee8.webapp.WebAppContext">
    <Set name="contextPath">/</Set>
</Configure>
