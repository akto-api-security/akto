<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 6.0//EN"
        "https://struts.apache.org/dtds/struts-6.0.dtd">
<struts>
    <constant name="struts.devMode" value="false"></constant>
    <constant name="struts.enable.SlashesInActionNames" value="true"/>
    <constant name="struts.mapper.alwaysSelectFullNamespace" value="false"/>
    <constant name="struts.patternMatcher" value="regex" />
    <constant name="struts.matcher.appendNamedParameters" value="true"/>
    <constant name="struts.multipart.maxSize" value = "209715200" />

    <package name="user2" namespace="" extends="struts-default, json-default">

        <!-- Default action for root path (/) - redirects to healthCheck -->
        <default-action-ref name="healthCheck" />

        <!-- Prometheus scrape endpoint. Deliberately in the root namespace (not api/*) so the
             JWT AuthFilter does not intercept it; InfraMetricsAction does its own Bearer-token
             auth (METRICS_AUTH_TOKEN) and exposure gating (PROMETHEUS_METRICS_ENABLED). -->
        <action name="metrics" class="com.akto.action.InfraMetricsAction">
        </action>

        <action name="api/ingestData" class="com.akto.action.IngestionAction" method="ingestData">
            <interceptor-ref name="json">
                <param name="maxStringLength">5242880</param>
                <param name="maxLength">10485760</param>
            </interceptor-ref>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^success.*</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^actionErrors.*</param>
            </result>
        </action>

        <action name="healthCheck" class="com.akto.action.IngestionAction" method="healthCheck">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json"/>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^actionErrors.*</param>
            </result>
        </action>

        <action name="api/auth-check" class="com.akto.action.IngestionAction" method="authCheck">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^success</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^actionErrors.*</param>
            </result>
        </action>

        <action name="api/http-proxy" class="com.akto.action.HttpProxyAction" method="httpProxy">
            <!-- The whole request body arrives as ONE string field (requestPayload), so a 5 MB
                 prompt needs a string limit above 5 MiB plus JSON-escaping headroom; the total
                 also carries responsePayload. 10 MiB per string, 20 MiB per body. -->
            <interceptor-ref name="json">
                <param name="maxStringLength">10485760</param>
                <param name="maxLength">20971520</param>
            </interceptor-ref>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^success,^message,^latencyMs,^data.*</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^success,^message,^latencyMs,^data.*</param>
            </result>
        </action>

        <!-- Multipart file validation, forwarded to guardrails-service /api/validate/file.
             Same path and form fields as guardrails-service, so callers switch by base URL.
             No "json" interceptor: the body is multipart, bound by defaultStack's actionFileUpload. -->
        <action name="api/validate/file" class="com.akto.action.FileValidationAction" method="validateFile">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="root">data</param>
            </result>
        </action>

        <!-- Generic AI-provider guardrail webhook: provider is the {1} path variable.
             Parses that provider's format (adapter registry), always runs guardrails
             + ingests. Adding a provider = one new adapter, no struts change. -->
        <action name="api/v1/webhooks/{provider}/guardrail/?" class="com.akto.action.ProviderGuardrailAction" method="guardrail">
            <param name="provider">{1}</param>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="root">response</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">404</param>
                <param name="root">response</param>
            </result>
        </action>

        <!-- Arcade Webhook Endpoints -->
        <action name="pre" class="com.akto.action.ArcadeWebhookAction" method="arcade">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^code,^error_message</param>
            </result>
            <result name="ERROR" type="json">
                <param name="includeProperties">^code,^error_message</param>
            </result>
        </action>

        <action name="post" class="com.akto.action.ArcadeWebhookAction" method="arcade">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^code,^error_message</param>
            </result>
            <result name="ERROR" type="json">
                <param name="includeProperties">^code,^error_message</param>
            </result>
        </action>

        <action name="copilot/threat-detection/validate" class="com.akto.action.CopilotStudioWebhookAction" method="checkReady">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^isSuccessful,^status</param>
            </result>
        </action>

        <action name="copilot/threat-detection/analyze-tool-execution" class="com.akto.action.CopilotStudioWebhookAction" method="analyzeToolExecution">
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^blockAction,^reason,^diagnostics</param>
            </result>
        </action>

        <action name="api/http-proxy/dify" class="com.akto.action.DifyModerationAction" method="moderation">
            <interceptor-ref name="json"/>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="root">difyResponse</param>
            </result>
            <result name="ERROR" type="json">
                <param name="root">difyResponse</param>
            </result>
        </action>

        <action name="api/http-proxy/truefoundry" class="com.akto.action.TrueFoundryProxyAction" method="truefoundry">
            <interceptor-ref name="json"/>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="excludeProperties">.*</param>
            </result>
            <result name="BLOCKED" type="json">
                <param name="statusCode">400</param>
                <param name="ignoreHierarchy">false</param>
                <param name="excludeProperties">.*</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^actionErrors.*</param>
            </result>
        </action>

        <!-- Proxy to database-abstractor -->
        <action name="api/updateModuleInfoForHeartbeat" class="com.akto.action.AbstractorProxyAction" method="proxy">
            <param name="subpath">updateModuleInfoForHeartbeat</param>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^success,^message,^data.*</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^success,^message</param>
            </result>
        </action>

        <action name="api/updateModuleInfoForHeartbeatV2" class="com.akto.action.AbstractorProxyAction" method="proxy">
            <param name="subpath">updateModuleInfoForHeartbeatV2</param>
            <interceptor-ref name="defaultStack" />
            <result name="SUCCESS" type="json">
                <param name="includeProperties">^success,^message,^data.*</param>
            </result>
            <result name="ERROR" type="json">
                <param name="statusCode">422</param>
                <param name="ignoreHierarchy">false</param>
                <param name="includeProperties">^success,^message</param>
            </result>
        </action>

    </package>

</struts>
