{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "~/.akto/hooks/akto-hook.sh github userPromptSubmitted",
        "powershell": "powershell -ExecutionPolicy Bypass -File %USERPROFILE%\\.akto\\hooks\\akto-hook.ps1 github userPromptSubmitted",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "~/.akto/hooks/akto-hook.sh github preToolUse",
        "powershell": "powershell -ExecutionPolicy Bypass -File %USERPROFILE%\\.akto\\hooks\\akto-hook.ps1 github preToolUse",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "~/.akto/hooks/akto-hook.sh github postToolUse",
        "powershell": "powershell -ExecutionPolicy Bypass -File %USERPROFILE%\\.akto\\hooks\\akto-hook.ps1 github postToolUse",
        "timeoutSec": 30
      }
    ]
  }
}