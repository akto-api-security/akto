{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-validate-prompt-wrapper.sh",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-validate-prompt-wrapper.ps1",
        "comment": "Validate prompts against Akto Guardrails (monitoring only - cannot block per GitHub limitation)",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-validate-pre-tool-wrapper.sh",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-validate-pre-tool-wrapper.ps1",
        "comment": "Validate and block tool execution based on Akto Guardrails policies",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-validate-post-tool-wrapper.sh",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-validate-post-tool-wrapper.ps1",
        "comment": "Ingest tool execution results to Akto for monitoring and analytics",
        "timeoutSec": 30
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py sessionStart",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py sessionStart",
        "comment": "Ingest session start event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py sessionEnd",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py sessionEnd",
        "comment": "Ingest session end event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py agentStop",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py agentStop",
        "comment": "Ingest turn-completion event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py subagentStart",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py subagentStart",
        "comment": "Ingest subagent-start event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py subagentStop",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py subagentStop",
        "comment": "Ingest subagent-completion event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py errorOccurred",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py errorOccurred",
        "comment": "Ingest agent error event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "preCompact": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py preCompact",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py preCompact",
        "comment": "Ingest pre-compact event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py notification",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py notification",
        "comment": "Ingest CLI notification event to Akto for observability",
        "timeoutSec": 10
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "bash": "bash ./.github/hooks/akto-hook-wrapper.sh akto-hooks.py userPromptTransformed",
        "powershell": "powershell -ExecutionPolicy Bypass -File .github/hooks/akto-hook-wrapper.ps1 akto-hooks.py userPromptTransformed",
        "comment": "Ingest transformed-prompt event to Akto for observability",
        "timeoutSec": 10
      }
    ]
  }
}
