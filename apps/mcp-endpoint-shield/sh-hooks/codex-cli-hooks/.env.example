AKTO_DATA_INGESTION_URL=http://localhost:80
AKTO_API_TOKEN=                             # Authorization header value sent to AKTO_DATA_INGESTION_URL

AKTO_TIMEOUT=5                              # Optional

OPENAI_BASE_URL=                            # Optional: derives the mirrored Codex API host if set

AKTO_SYNC_MODE=true
MODE=atlas                                  # Optional: atlas or argus
DEVICE_ID=                                  # Optional: overrides auto-detected machine id
AKTO_CONNECTOR=codex_cli                    # Optional: connector label used in the akto_connector query param
AKTO_CONNECTOR_VALUE=codexcli               # Optional: short tag used in atlas hostnames/ai-agent tags
CONTEXT_SOURCE=ENDPOINT                     # Optional

LOG_DIR=~/.codex/akto/logs                  # Optional
LOG_LEVEL=INFO                              # Optional
LOG_PAYLOADS=false                          # Optional: logs request/response payload previews

# Built-in (non-MCP) tool mirror/ingest (same defaults as claude-cli-hooks mcp hooks).
AKTO_INGEST_NON_MCP_TOOLS=false
MCP_INGEST_PATH=/mcp                        # Optional
# NON_MCP_TOOL_PATH_PREFIX=/tool
# NON_MCP_INGEST_PATH=
