# Settings for the log-pipeline consumer (read by docker compose via env_file).
# Edit here, then: SKIP_BUILD=true docker compose up -d --force-recreate log-consumer
# Values here are for the compose network (kafka / mongo-logs are the service names).
# To run the consumer outside docker, copy this file and change the hosts to localhost:9192 / localhost:27018.

# --- NEW logs MongoDB (the consumer writes here; never point this at cyborg's main DB)
AKTO_MONGO_CONN=mongodb://mongo-logs:27017
AKTO_INSTANCE_TYPE=DATABASE_ABS
AKTO_LOG_LEVEL=DEBUG

# --- Kafka
LOG_KAFKA_BROKER_URL=kafka:19092
LOG_KAFKA_TOPIC_LOGS=akto.logs
LOG_KAFKA_TOPIC_METRICS=akto.metrics
LOG_KAFKA_GROUP_ID_LOGS=log-writer-logs
LOG_KAFKA_GROUP_ID_METRICS=log-writer-metrics

# --- Scaling: threads per container; more containers = --scale log-consumer=N (max total = topic partitions, 10)
LOG_CONSUMER_THREADS=2
# LOG_CONSUMER_THREADS_METRICS=2      # defaults to LOG_CONSUMER_THREADS
# LOG_CONSUMER_ROLES=logs,metrics      # logs | metrics | logs,metrics  (dedicated consumers per topic)
LOG_CONSUMER_MAX_POLL_RECORDS=1000

# --- Stop flag (Kafka keeps buffering while paused). Initial state; flip at runtime with the pause file:
#     docker compose exec log-consumer touch /tmp/log-consumer.pause   (rm to resume)
LOG_CONSUMER_PAUSED=false

# --- Must stay false/unset here: the consumer must not publish back into Kafka or start crons.
LOG_PIPELINE_ACCOUNTS=
TRIGGER_MERGING_CRON=false
PROMETHEUS_METRICS_ENABLED=false

# --- JVM
JAVA_OPTS=-Xmx512m
LOG_CONSUMER_MAIN=com.akto.logpipeline.LogPipelineConsumerMain
