# Env for running cyborg on the HOST (../start-cyborg.sh) with the log pipeline ON.
# Cyborg keeps its normal main DB (your local mongod); only logs/metrics go to Kafka -> new logs Mongo.
#   cp cyborg.env.example ../local.env     (start-cyborg.sh sources ../local.env)
#   or: set -a; source log-pipeline-dev/cyborg.env.example; set +a; ./start-cyborg.sh

export AKTO_MONGO_CONN=${AKTO_MONGO_CONN:-mongodb://localhost:27017}   # main DB, unchanged

# THE ONE FLAG. Unset/false => today's behaviour (direct Mongo writes). true => publish to Kafka.
export LOG_KAFKA_ENABLED=true
export LOG_KAFKA_BROKER_URL=localhost:9192      # compose host listener (KAFKA_HOST_PORT)
export LOG_KAFKA_TOPIC_LOGS=akto.logs
export LOG_KAFKA_TOPIC_METRICS=akto.metrics
