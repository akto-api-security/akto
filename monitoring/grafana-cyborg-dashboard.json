  },
  "timepicker": {},
  "timezone": "",
  "title": "Cyborg (database-abstractor)",
  "uid": "cyborg-db-abstractor",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Process and system CPU.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "process_cpu_usage{service=\"cyborg\", role=~\"$role\", instance=~\"$instance\"}",
          "legendFormat": "process",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "system_cpu_usage{service=\"cyborg\", role=~\"$role\", instance=~\"$instance\"}",
          "legendFormat": "system",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM memory used",
      "description": "Heap / non-heap used, plus committed heap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (area) (jvm_memory_used_bytes{service=\"cyborg\", role=~\"$role\", instance=~\"$instance\"})",
          "legendFormat": "used {{area}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(jvm_memory_committed_bytes{service=\"cyborg\", role=~\"$role\", instance=~\"$instance\", area=\"heap\"})",
          "legendFormat": "heap committed",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "description": "All endpoints.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (uri) (rate(http_requests_total{service=\"cyborg\", role=~\"$role\", instance=~\"$instance\", uri!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p90 by endpoint",
      "description": "All endpoints, p90.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.90, sum by (le, uri) (rate(http_request_duration_seconds_bucket{service=\"cyborg\", role=~\"$role\", instance=~\"$instance\", uri!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    }
  ]
}