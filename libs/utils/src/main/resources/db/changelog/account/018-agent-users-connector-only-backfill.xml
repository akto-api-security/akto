<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/mongodb
        http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <!--
        AgenticUsers gained a new connectorOnly field (AgentUsersDao.ensureConnectorIdentity):
        true only for identities self-registered from connector traffic with no real
        endpoint-shield device (e.g. a Claude Inference Hooks actor). ModuleInfoAction's
        fetchAgenticUsers now checks this flag to decide whether to preserve a doc's stored
        `devices` when there's no live module_info heartbeat to resolve them from.

        Not required for correctness: Java's boolean default (false) already applies in memory
        to any pre-existing document missing this field, and every new document written by
        ensureConnectorIdentity sets it explicitly. This backfill just makes that default
        explicit on disk for every document that predates the field, so the stored shape matches
        what the application already assumes.

        Idempotent: only touches documents where connectorOnly doesn't exist yet, so it never
        overwrites a doc a later app version already wrote connectorOnly: true onto.
    -->

    <changeSet id="018-account-agent-users-connector-only-backfill" author="akto">
        <preConditions onFail="MARK_RAN">
            <mongodb:collectionExists collectionName="agent_users"/>
        </preConditions>
        <mongodb:runCommand>
            <mongodb:command>{
                "update": "agent_users",
                "updates": [
                    {
                        "q": { "connectorOnly": { "$exists": false } },
                        "u": { "$set": { "connectorOnly": false } },
                        "multi": true
                    }
                ]
            }</mongodb:command>
        </mongodb:runCommand>
        <rollback>
            <mongodb:runCommand>
                <mongodb:command>{
                    "update": "agent_users",
                    "updates": [
                        {
                            "q": { "connectorOnly": false },
                            "u": { "$unset": { "connectorOnly": "" } },
                            "multi": true
                        }
                    ]
                }</mongodb:command>
            </mongodb:runCommand>
        </rollback>
    </changeSet>

</databaseChangeLog>
