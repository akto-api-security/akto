<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
        http://www.liquibase.org/xml/ns/mongodb
        http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <!--
        MCP OAuth (CommonContextDao, DB: common).
        mcp_oauth_clients (McpOAuthClientsDao): dynamically registered OAuth clients; lastUsedAt is a
        BSON Date and the TTL index drops clients unused for 90 days.
        mcp_oauth_grants (McpOAuthGrantsDao): pending consent requests, authorization codes and refresh
        tokens, keyed by the SHA-256 of the secret; the TTL index on expiresAt (a BSON Date) removes
        expired grants.
        Index names and options mirror each DAO's createIndicesIfAbsent exactly, so these are no-ops
        where the runtime call already built them.
    -->

    <changeSet id="007-common-create-mcp-oauth-clients" author="akto">
        <preConditions onFail="MARK_RAN">
            <not>
                <mongodb:collectionExists collectionName="mcp_oauth_clients"/>
            </not>
        </preConditions>
        <mongodb:createCollection collectionName="mcp_oauth_clients"/>
        <rollback>
            <mongodb:dropCollection collectionName="mcp_oauth_clients"/>
        </rollback>
    </changeSet>

    <changeSet id="007-common-mcp-oauth-clients-last-used-ttl-index" author="akto">
        <preConditions onFail="MARK_RAN">
            <mongodb:collectionExists collectionName="mcp_oauth_clients"/>
        </preConditions>
        <mongodb:createIndex collectionName="mcp_oauth_clients">
            <mongodb:keys>{ "lastUsedAt": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "lastUsedAt_ttl", "expireAfterSeconds": 7776000 }</mongodb:options>
        </mongodb:createIndex>
        <rollback>
            <mongodb:dropIndex collectionName="mcp_oauth_clients">
                <mongodb:keys>{ "lastUsedAt": 1 }</mongodb:keys>
            </mongodb:dropIndex>
        </rollback>
    </changeSet>

    <changeSet id="007-common-create-mcp-oauth-grants" author="akto">
        <preConditions onFail="MARK_RAN">
            <not>
                <mongodb:collectionExists collectionName="mcp_oauth_grants"/>
            </not>
        </preConditions>
        <mongodb:createCollection collectionName="mcp_oauth_grants"/>
        <rollback>
            <mongodb:dropCollection collectionName="mcp_oauth_grants"/>
        </rollback>
    </changeSet>

    <changeSet id="007-common-mcp-oauth-grants-expires-at-ttl-index" author="akto">
        <preConditions onFail="MARK_RAN">
            <mongodb:collectionExists collectionName="mcp_oauth_grants"/>
        </preConditions>
        <mongodb:createIndex collectionName="mcp_oauth_grants">
            <mongodb:keys>{ "expiresAt": 1 }</mongodb:keys>
            <mongodb:options>{ "name": "expiresAt_ttl", "expireAfterSeconds": 0 }</mongodb:options>
        </mongodb:createIndex>
        <rollback>
            <mongodb:dropIndex collectionName="mcp_oauth_grants">
                <mongodb:keys>{ "expiresAt": 1 }</mongodb:keys>
            </mongodb:dropIndex>
        </rollback>
    </changeSet>

</databaseChangeLog>
